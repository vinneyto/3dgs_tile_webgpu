{
  "name": "3dgs-tile-webgpu",
  "version": "0.1.0",
  "description": "GPU-driven tiled 3D Gaussian Splatting pass for Three.js WebGPU",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend-entry.d.ts",
      "import": "./dist/backend.js"
    },
    "./spark": {
      "types": "./dist/spark-entry.d.ts",
      "import": "./dist/spark.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/render-extensions.md",
    "docs/dynamic-intersections.md",
    "docs/stable-pipeline.md",
    "docs/lod-stabilization.md",
    "scripts/build-wasm.mjs",
    "THIRD_PARTY_NOTICES.md",
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/gaussian-backend",
    "rust/vendor/spark-lib",
    "vendor/spark",
    "scripts/build-spark-wasm.mjs",
    "scripts/verify-spark-vendor.mjs",
    "docs/upstream-spark-experiment.md"
  ],
  "scripts": {
    "dev": "vite",
    "sandbox": "vite --config vite.sandbox.config.ts",
    "sandbox:build": "vite build --config vite.sandbox.config.ts",
    "build": "vite build && vite build --config vite.backend.config.ts && vite build --config vite.spark.config.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:test": "cargo test --manifest-path rust/Cargo.toml -p gaussian-backend",
    "spark:verify": "node scripts/verify-spark-vendor.mjs",
    "spark:build": "node scripts/build-spark-wasm.mjs"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "dependencies": {
    "@types/three": "^0.185.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.66",
    "prettier": "^3.6.2",
    "three": "^0.185.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wgsl_reflect": "^1.6.0"
  }
}
